    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nconst expectedClasses = {\n  \"VIRTUAL ASSISTANT\": 24,\n  \"UI/UX DESIGN\": 24,\n  \"PROJECT MANAGEMENT\": 24,\n  \"AI AUTOMATION\": 24,\n  \"DIGITAL MARKETING\": 24,\n  \"FRONT-END DEVELOPMENT\": 24,\n  \"DATA ANALYSIS\": 24,\n  \"CYBERSECURITY\": 36\n};\n\nconst students = {};\n\nfor (const item of rows) {\n  const data = item.json;\n\n  const studentId = data[\"STUDENT ID\"];\n  const studentName = data[\"STUDENT NAME\"];\n  const email = data[\"EMAIL\"];\n  const track = String(data[\"TRACK\"] || \"\").trim();\n  const status = String(data[\"STATUS\"] || \"\").trim().toUpperCase();\n\n  const key = studentId || email || studentName;\n\n  if (!key) continue;\n\n  if (!students[key]) {\n    students[key] = {\n      studentId,\n      studentName,\n      email,\n      track,\n      attended: 0,\n      absent: 0\n    };\n  }\n\n  if (status === \"PRESENT\") {\n    students[key].attended++;\n  } else if (status === \"ABSENT\") {\n    students[key].absent++;\n  }\n}\n\nreturn Object.values(students).map(student => {\n\n  const totalClasses =\n    expectedClasses[student.track.toUpperCase()] || 24;\n\n  const percentage =\n    (student.attended / totalClasses) * 100;\n\n  return {\n    json: {\n      \"STUDENT ID\": student.studentId,\n      \"STUDENT NAME\": student.studentName,\n      \"EMAIL\": student.email,\n      \"TRACK\": student.track,\n      \"TOTAL CLASSES\": totalClasses,\n      \"CLASSES ATTENDED\": student.attended,\n      \"CLASSES ABSENT\": student.absent,\n      \"ATTENDANCE PERCENTAGE\": Number(percentage.toFixed(2)),\n      \"ATTENDANCE RESULT\":\n        percentage >= 80\n          ? \"Meets attendance requirement\"\n          : \"Management review\"\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
