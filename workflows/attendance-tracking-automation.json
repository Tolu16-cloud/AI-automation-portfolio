    {
      "parameters": {
        "jsCode": "// Get the attendance information from the Form Trigger\nconst formData = $items(\"On form submission\")[0].json;\n\n// Get the students marked absent from the form\nconst absentStudents = String(formData[\"Students Absent\"] || \"\")\n  .split(\",\")\n  .map(name => name.trim().toLowerCase());\n\n// Get all students returned from Google Sheets\nconst students = $input.all();\n\n// Check each student\nreturn students.map(item => {\n\n  // Get the student's name from Google Sheets\n  const studentName = String(item.json[\"Full Name\"] || \"\")\n    .trim()\n    .toLowerCase();\n\n  // Check if the student's name is on the absent list\n  const isAbsent = absentStudents.includes(studentName);\n\n  // Add attendance information\n  item.json[\"Status\"] = isAbsent ? \"Absent\" : \"Present\";\n\n  // Add class information from the form\n  item.json[\"Date\"] = formData[\"Date\"];\n  item.json[\"Week\"] = formData[\"Week\"];\n  item.json[\"Class\"] = formData[\"Class e.g week 1 class 1, week 1 class 2\"];\n  item.json[\"Instructor\"] = formData[\"Instructor's name\"];\n\n  return item;\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        -144
      ],
      "id": "5d9b2340-ce52-4291-b0d6-74b3e7544c0c",
