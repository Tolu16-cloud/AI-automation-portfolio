    {
      "parameters": {
        "jsCode": "const records = $input.all();\n\n// Group records by student ID\nconst students = {};\n\nfor (const item of records) {\n  const data = item.json;\n\n  const studentId = String(data[\"STUDENT ID\"] || \"\").trim();\n\n  if (!studentId) continue;\n\n  if (!students[studentId]) {\n    students[studentId] = [];\n  }\n\n  students[studentId].push(data);\n}\n\nconst results = [];\n\n// Check each student's attendance records\nfor (const studentId in students) {\n\n  const attendance = students[studentId];\n\n  // We need at least 2 records\n  if (attendance.length < 2) continue;\n\n  // Look through consecutive records\n  for (let i = 1; i < attendance.length; i++) {\n\n    const previousStatus = String(\n      attendance[i - 1][\"STATUS\"] || \"\"\n    ).trim().toLowerCase();\n\n    const currentStatus = String(\n      attendance[i][\"STATUS\"] || \"\"\n    ).trim().toLowerCase();\n\n    // Check for two consecutive absences\n    if (\n      previousStatus === \"absent\" &&\n      currentStatus === \"absent\"\n    ) {\n\n      const student = attendance[i];\n\n      results.push({\n        json: {\n          \"STUDENT ID\": student[\"STUDENT ID\"],\n          \"STUDENT NAME\": student[\"STUDENT NAME\"],\n          \"EMAIL\": student[\"EMAIL\"],\n          \"TRACK\": student[\"TRACK\"],\n          \"Consecutive Absences\": 2,\n          \"Last Absence Date\": student[\"DATE\"]\n        }\n      });\n\n      // Stop checking this student after finding 2 absences\n      break;\n    }\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        -144
      ],
